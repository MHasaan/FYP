# ===========================================
# FYP Project - Environment Configuration
# ===========================================

# ----------- Database -----------
POSTGRES_USER=fyp_user
POSTGRES_PASSWORD=fyp_secure_password_2026
POSTGRES_DB=fyp_database
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fyp_user:fyp_secure_password_2026@database:5432/fyp_database

# ----------- Redis -----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ----------- Backend -----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# API Authentication (leave empty to disable)
API_KEY=

# CORS Origins (comma-separated list, e.g., http://localhost:3000,http://localhost:8080)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:80,http://localhost

# ----------- ML Manager -----------
ML_MANAGER_HOST=0.0.0.0
ML_MANAGER_PORT=8001

# ----------- Camera Defaults -----------
DEFAULT_CAMERA_SOURCE=0
# Options: 0 (USB), rtsp://ip:port/stream, http://ip:port/video, /videos/sample.mp4
CAMERA_FPS=30
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ----------- Frontend -----------
FRONTEND_PORT=80
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000
