# Environment
.env.local
.env.production

# Docker
# docker-compose.override.yml is tracked because it contains GPU config

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ML Model weights (large files)
# ml_manager/models/*.pt
# ml_manager/models/*.pth
# ml_manager/models/*.onnx
# ml_manager/models/*.tflite
!ml_manager/models/.gitkeep

# Flutter
frontend/.dart_tool/
frontend/.packages
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Videos (test files)
# videos/*.mp4
# videos/*.avi
!videos/.gitkeep

# Firebase / FCM credentials (NEVER commit)
backend/credentials/*.json
!backend/credentials/.gitkeep
frontend/android/app/google-services.json
frontend/ios/Runner/GoogleService-Info.plist
frontend/lib/firebase_options.dart

# Built APKs (don't commit ~50 MB binaries)
*.apk

# ML manager local model cache
ml_manager/cache/

# Claude Code local logs / settings
.claude/


# FYP-2 report scratch materials (large docs, PDFs, images — kept locally)
reportFYP/
_docx_media/
_extract_proposal.txt
_extract_report.txt
FINAL_INSTRUCTIONS_FOR_BOTH_LIKE_HUMANS.txt

# Runtime video data (only keep curated samples under videos/recordings/)
videos/uploads/
videos/gdino_inputs/
videos/gdino_outputs/
